# Embedding Provider (optional - auto-detects best available)
# RAG_EMBEDDING_PROVIDER=auto       # auto | st | gguf | openai | cohere
# RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2  # Model name

# Local GGUF models (optional - for gguf provider only)
# RAG_EMBEDDING_MODEL_PATH=/path/to/model.gguf

# OpenAI API (optional - for openai provider)
# OPENAI_API_KEY=sk-...

# Cohere API (optional - for cohere provider)
# COHERE_API_KEY=...

# Vector Store (optional - defaults to ~/.local/share/rag-mcp/)
# RAG_QDRANT_PATH=/path/to/qdrant
# RAG_QDRANT_COLLECTION=rag_documents

# Pipeline (optional)
# RAG_DATA_DIR=/path/to/data
# RAG_ALLOWED_INPUT_DIR=/path/to/input
# RAG_CHUNK_SIZE=1024
# RAG_CHUNK_OVERLAP=128

# MCP Server (optional)
# RAG_MCP_HOST=127.0.0.1
# RAG_MCP_PORT=3000
# LOG_LEVEL=INFO
